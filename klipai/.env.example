# ── Ortak ──
NODE_ENV=development
DATABASE_URL=postgresql://klipai:klipai@localhost:5432/klipai
REDIS_URL=redis://localhost:6379

# ── API ──
PORT=3000
PUBLIC_API_URL=http://localhost:3000
APP_SCHEME=klipai
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
# openssl rand -base64 32  (tam 32 bayt)
TOKEN_ENC_KEY=
# openssl rand -hex 32  (API ile video servisi aynı değeri kullanır)
INTERNAL_HMAC_SECRET=change-me-change-me-change-me-change-me
RUN_WORKERS=true

# S3 uyumlu depolama (yerelde MinIO)
S3_ENDPOINT=http://localhost:9000
# İmzalı URL'lerde istemcinin göreceği adres (telefonda test için bilgisayarın LAN IP'si)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=klipai-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Google (giriş + YouTube). Web istemcisi; yönlendirme URI'si: {PUBLIC_API_URL}/v1/channels/youtube/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS/Android istemci kimlikleri (Google ile girişte ID token alıcısı), virgülle
GOOGLE_EXTRA_AUDIENCES=
YOUTUBE_DAILY_QUOTA=10000

REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=
SMTP_URL=
MAIL_FROM=KlipAI <no-reply@klipai.app>
SENTRY_DSN=

# Geliştirici hesabı (npm run db:seed). Parolayı yalnızca bu dosyada tutun; depoya girmez.
SEED_DEV_USERNAME=
SEED_DEV_PASSWORD=
SEED_DEV_EMAIL=

# ── Video servisi ──
API_INTERNAL_URL=http://localhost:3000/v1
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
HF_TOKEN=
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WORKER_QUEUES=ingest,analyze,candidates,score,commentary,edit,metadata,qc
