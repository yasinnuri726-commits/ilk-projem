{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3000/v1" } },
    "staging": { "distribution": "internal", "channel": "staging", "env": { "EXPO_PUBLIC_API_URL": "https://api.staging.klipai.app/v1" } },
    "production": { "channel": "production", "autoIncrement": true, "env": { "EXPO_PUBLIC_API_URL": "https://api.klipai.app/v1" } }
  },
  "submit": { "production": {} }
}
