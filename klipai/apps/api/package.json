{
  "name": "@klipai/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.13.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.6",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}