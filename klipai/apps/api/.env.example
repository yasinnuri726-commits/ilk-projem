# Yol: klipai/apps/api/.env.example  →  .env olarak kopyalayın
NODE_ENV=development
# http | worker | all  (all: tek süreçte API + orkestratör; geliştirme için)
ROLE=all
PORT=3000

DATABASE_URL=postgresql://klipai:klipai@localhost:5432/klipai
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_SECRET=degistir-en-az-32-karakter-uzunlugunda-bir-sir
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# Google ile giriş: iOS, Android ve web istemci kimlikleri (virgülle)
GOOGLE_CLIENT_IDS=

# S3 uyumlu depolama (dev: MinIO)
S3_ENDPOINT=http://localhost:9000
# Telefonun erişebildiği adres; imzalı adresler bununla üretilir (boşsa S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=klipai-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# OAuth token şifreleme anahtarları: "sürüm:base64(32 bayt)", virgülle. En büyük sürüm kullanılır.
# openssl rand -base64 32
TOKEN_ENC_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Bu e-postalarla kayıtlı hesaplar abonelik gerekmeden sınırsız kullanır (virgülle)
OWNER_EMAILS=

# E-posta bağlantılarının öneki (derin bağlantı)
APP_URL=klipai://
# Boşsa e-postalar gönderilmez, log'a yazılır
SMTP_URL=
MAIL_FROM=KlipAI <no-reply@klipai.app>

PUBLIC_WS_URL=ws://localhost:3000
CORS_ORIGINS=
SENTRY_DSN=

# 1: video servisi yokken hattı sahte sonuçlarla çalıştıran worker'lar (yalnızca dev/test)
PIPELINE_STUB=0
