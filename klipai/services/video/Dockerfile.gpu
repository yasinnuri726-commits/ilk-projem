# GPU worker: analyze (Whisper large-v3, yüz, sahne, konuşmacı) ve edit (NVENC)
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3.11 python3.11-venv python3-pip ffmpeg fonts-inter fonts-dejavu-core fonts-noto-core curl libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /usr/share/fonts/truetype/montserrat /opt/models \
    && curl -fsSL -o /usr/share/fonts/truetype/montserrat/Montserrat-ExtraBold.ttf https://github.com/JulietaUla/Montserrat/raw/master/fonts/ttf/Montserrat-ExtraBold.ttf \
    && curl -fsSL -o /usr/share/fonts/truetype/montserrat/Montserrat-Bold.ttf https://github.com/JulietaUla/Montserrat/raw/master/fonts/ttf/Montserrat-Bold.ttf \
    && curl -fsSL -o /opt/models/face_detection_yunet_2023mar.onnx https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx \
    && fc-cache -f
WORKDIR /app
COPY pyproject.toml ./
COPY klipai_video ./klipai_video
RUN python3.11 -m pip install --no-cache-dir ".[analysis]"
ENV WORKER_QUEUES=analyze,edit VIDEO_ENCODER=h264_nvenc WHISPER_DEVICE=cuda PYTHONUNBUFFERED=1 HF_HOME=/models/hf
VOLUME /models
CMD ["python3.11", "-m", "klipai_video.worker"]
