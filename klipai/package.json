{
  "name": "klipai",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:api": "pnpm --filter @klipai/shared build && pnpm --filter @klipai/api dev",
    "db:migrate": "pnpm --filter @klipai/api db:migrate",
    "db:seed": "pnpm --filter @klipai/api db:seed",
    "lint:api-contract": "redocly lint docs/api/openapi.yaml --config docs/api/redocly.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^2.78.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "@prisma/engines", "argon2", "prisma", "esbuild", "@sentry/profiling-node"]
  }
}
